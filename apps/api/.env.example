PORT=5801
CORS_ORIGIN=http://localhost:5800

# Admin key for the web app and other admin routes — generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Postgres connection string. Bun's built-in `sql` reads this automatically.
# Dev Postgres runs via docker-compose.dev.yml on port 5802.
DATABASE_URL=postgres://printer:printer@localhost:5802/printer

# Cloudflare R2 — archive printed images (prod only). Leave unset in dev to skip.
# Set all four to enable. Bucket API token from the R2 dashboard.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public base URL of the bucket (r2.dev domain or a custom one). When set, the
# admin queue shows a "Ver original" link to each archived image.
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
