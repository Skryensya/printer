VITE_API_URL=http://localhost:3001

# A per-service API key created via the Keys page (used by the playground)
VITE_API_KEY=

# Must match ADMIN_API_KEY in apps/api/.env
VITE_ADMIN_API_KEY=

# Admin login credentials for the web UI
ADMIN_USER=admin
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
