# Public — baked into the client bundle (NOT a secret). Used by the docs page,
# where the user pastes their own key.
VITE_API_URL=http://localhost:5801

# ─── Server-side only — never reach the browser ───────────────────────────────
# The web server proxies admin/print calls to the printer API with these.
PRINTER_API_URL=http://localhost:5801
# Service key (e.g. the "playground" key) — used for print endpoints.
PRINTER_API_KEY=
# Admin key — must match ADMIN_API_KEY in apps/api. Used for admin endpoints and
# to sign the watch-WebSocket token.
ADMIN_API_KEY=

# ─── Wall (for the "reset wall cooldowns" button) ─────────────────────────────
# Where the wall app is reachable from the web server.
WALL_INTERNAL_URL=http://localhost:5803
# Shared secret — must match WALL_ADMIN_KEY in apps/wall.
WALL_ADMIN_KEY=

# ─── Web admin login + session ────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
