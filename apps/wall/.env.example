# ─── Printer API (server-side only — never exposed to the browser) ────────────
WALL_API_URL=http://localhost:5801
# A key created in the admin console with the "message" (or "message_custom")
# permission. Rate limits on this key are what the wall throttles itself to.
WALL_API_KEY=

# Session secret for logged-in wall accounts. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ─── Per-IP cooldown ──────────────────────────────────────────────────────────
# Milliseconds before the same IP may submit again. Default: 30 minutes.
WALL_COOLDOWN_MS=1800000

# Where the queue + cooldown ledger is persisted (so a restart can't reset it).
WALL_DATA_DIR=.wall-data

# Minimum gap between sends to the printer API, on top of the API's own limits.
WALL_DRAIN_INTERVAL_MS=1500

# How long the local photo thumbnail (fallback) survives before being swept.
# R2 is the permanent store; this only bridges the upload window. Default: 1h.
WALL_PHOTO_TTL_MS=3600000

# ─── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
# Server-side secret. If unset, captcha verification is bypassed (dev only).
WALL_RECAPTCHA_SECRET=
# Client-side site key (exposed to the browser by Vite — must be VITE_ prefixed).
VITE_WALL_RECAPTCHA_SITE_KEY=
