{
  "name": "@printer/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PRINTER_PRIORITY=low bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check-types": "tsc --noEmit",
    "daemon:start": "bun launchd.ts start",
    "daemon:stop": "bun launchd.ts stop",
    "daemon:restart": "bun launchd.ts restart"
  },
  "dependencies": {
    "@printer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
