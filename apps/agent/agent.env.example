# Prod daemon config. Copy to `agent.env` (gitignored) and fill in.
# `bun run daemon:start` copies this into /usr/local/etc/printer-agent.env (chmod 600)
# and the launchd daemon loads it via `bun --env-file`. This is the PROD agent — it
# stays high-priority (no PRINTER_PRIORITY here) so it wins over a dev agent.

# Public API URL (the agent rewrites http->ws itself)
SERVER_URL=https://api.printer.example.com

# Service key the agent authenticates with
API_KEY=REPLACE_WITH_AGENT_KEY

# Set to true to simulate printing without hardware
# DRY_RUN=false
