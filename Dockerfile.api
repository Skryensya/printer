FROM oven/bun:1
WORKDIR /app

# libusb runtime: @printer/core re-exports Printer (node-usb), which the API loads
# transitively even though it never drives the printer itself.
RUN apt-get update \
  && apt-get install -y --no-install-recommends libusb-1.0-0 \
  && rm -rf /var/lib/apt/lists/*

# All workspace manifests so install resolves the whole monorepo graph (the
# source of the other apps is NOT copied). Not --frozen: the committed lock is
# generated on macOS, and platform-specific native deps (sharp, usb) differ on
# the linux build host, which a frozen lock would reject.
COPY package.json bun.lock ./
COPY packages/core/package.json ./packages/core/
COPY apps/api/package.json   ./apps/api/
COPY apps/web/package.json   ./apps/web/
COPY apps/agent/package.json ./apps/agent/
COPY apps/wall/package.json  ./apps/wall/

RUN bun install

COPY packages/core ./packages/core
COPY apps/api ./apps/api

# DATABASE_URL, ADMIN_API_KEY, CORS_ORIGIN, PORT provided at runtime (Dokploy env)
EXPOSE 5810
CMD ["bun", "apps/api/src/index.ts"]
