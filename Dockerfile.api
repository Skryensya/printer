FROM oven/bun:1
WORKDIR /app

# libusb runtime: @printer/core re-exports Printer (node-usb), which the API loads
# transitively even though it never drives the printer itself.
RUN apt-get update \
  && apt-get install -y --no-install-recommends libusb-1.0-0 \
  && rm -rf /var/lib/apt/lists/*

# All workspace manifests are needed for --frozen-lockfile to validate against
# the monorepo lockfile (the source of the other apps is NOT copied).
COPY package.json bun.lock ./
COPY packages/core/package.json ./packages/core/
COPY apps/api/package.json   ./apps/api/
COPY apps/web/package.json   ./apps/web/
COPY apps/agent/package.json ./apps/agent/
COPY apps/wall/package.json  ./apps/wall/

RUN bun install --frozen-lockfile

COPY packages/core ./packages/core
COPY apps/api ./apps/api

# DATABASE_URL, ADMIN_API_KEY, CORS_ORIGIN, PORT provided at runtime (Dokploy env)
EXPOSE 5810
CMD ["bun", "apps/api/src/index.ts"]
