# Production secrets for docker-compose.yml.
# Copy to .env.prod and fill in, then:
#   docker compose --env-file .env.prod up -d --build

# Postgres password (used by both the postgres service and the api's DATABASE_URL)
POSTGRES_PASSWORD=change-me

# Admin key for the web app and admin routes — generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Allowed CORS origin for the web app (e.g. https://printer.example.com)
CORS_ORIGIN=*
